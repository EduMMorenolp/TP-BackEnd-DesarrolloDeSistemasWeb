doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
     
    title La Espiga de Oro - Panel

    link(rel="stylesheet", href="/public/styles.css")

    script(src="/public/auth.js")
    script.
      document.addEventListener('DOMContentLoaded', () => {
        if (isAdmin()) {
          document.querySelectorAll('.admin-link, .admin-card').forEach(el => el.style.display = '');
        }
      });
    
  body
    header.user-header
      
      div.user-info
        span Hola, 
        span#userNameDisplay Cargando...      
      
      nav.nav-right
        a(href="/index") Inicio
        a(href="/dashboard") Dashboard
        a(href="/sucursales") Sucursales
        a(href="/productos") Productos
        a(href="/pedidos") Pedidos
        a.admin-link(href="/usuarios", style="display:none") Usuarios
        a.btn-logout(href="#", onclick="logout()") Cerrar Sesión

    section.hero
      h1 Te damos la bienvenida al panel
      p Seleccioná un módulo para empezar a administrar tus sucursales, productos y pedidos en tiempo real.
    section.grid
      article.card
        h2 Modulo Sucursales
        p Alta, consulta, actualizacion y baja logica de sucursales y franquicias.
        .actions
          a.btn(href="/sucursales") Ir a Sucursales
      article.card
        h2 Modulo Productos
        p Catalogo de productos con validaciones de precio y disponibilidad.
        .actions
          a.btn(href="/productos") Ver Productos
      article.card
        h2 Modulo Pedidos
        p Creacion y seguimiento de pedidos con flujo de estados.
        .actions
          a.btn(href="/pedidos") Ver Pedidos
      article.card.admin-card(style="display:none")
        h2 Modulo Usuarios
        p Administracion de usuarios, roles y sucursales.
        .actions
          a.btn(href="/usuarios") Ir a Usuarios
      article.card
        h2 Dashboard
        p Vista general del sistema con métricas, pedidos recientes y estado de sucursales.
        .actions
          a.btn(href="/dashboard") Ir al Dashboard
   
    p.foot Desarrollado por Grupo Clouds